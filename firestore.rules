rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'chiposhaconwell@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'cornbtechnologies@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.firebase.sign_in_provider == 'password' &&
         request.auth.token.email == 'cred_14502f2917bd7baffecafd15a60218ad4c6a666a73d3c9c89f5ed487@mt-pos.auth') ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate: Relational checks against parent Business & Membership documents
    function isActiveOwnerMember(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.memberUid == request.auth.uid &&
        get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.role == 'owner';
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid
        ) ||
        isActiveOwnerMember(businessId)
      );
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid
        ) ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.status == 'ACTIVE' &&
          get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.memberUid == request.auth.uid
        )
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)

    function isValidBusiness(data) {
      return data.keys().hasAll([
               'id', 'business_id', 'store_id', 'name', 'owner', 'email', 'ownerUid',
               'currency', 'tax_rate', 'tpin', 'billing_address', 'billing_city',
               'billing_country', 'billing_phone', 'billing_email', 'admin_role',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'business_id', 'store_id', 'name', 'owner', 'email', 'ownerUid',
               'currency', 'tax_rate', 'tpin', 'billing_address', 'billing_city',
               'billing_country', 'billing_phone', 'billing_email', 'admin_role',
               'status', 'suspended_reason', 'suspended_at', 'suspended_by',
               'flagged_for_fraud', 'fraud_flag_reason', 'flagged_at',
               'plan_tier', 'subscription_status',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.business_id == data.id &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.owner is string && data.owner.size() >= 1 && data.owner.size() <= 200 &&
             data.email is string && data.email.size() >= 1 && data.email.size() <= 200 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.currency is string && data.currency.size() <= 20 &&
             data.tax_rate is number && data.tax_rate >= 0.0 &&
             data.tpin is string && data.tpin.size() <= 100 &&
             data.billing_address is string && data.billing_address.size() <= 500 &&
             data.billing_city is string && data.billing_city.size() <= 200 &&
             data.billing_country is string && data.billing_country.size() <= 200 &&
             data.billing_phone is string && data.billing_phone.size() <= 100 &&
             data.billing_email is string && data.billing_email.size() <= 200 &&
             data.admin_role is string && data.admin_role.size() <= 50 &&
             (!('status' in data) || data.status in ['ACTIVE', 'SUSPENDED']) &&
             (!('suspended_reason' in data) || (data.suspended_reason is string && data.suspended_reason.size() <= 1000)) &&
             (!('suspended_at' in data) || (data.suspended_at is string && data.suspended_at.size() <= 100)) &&
             (!('suspended_by' in data) || (data.suspended_by is string && data.suspended_by.size() <= 200)) &&
             (!('flagged_for_fraud' in data) || data.flagged_for_fraud is bool) &&
             (!('fraud_flag_reason' in data) || (data.fraud_flag_reason is string && data.fraud_flag_reason.size() <= 1000)) &&
             (!('flagged_at' in data) || (data.flagged_at is string && data.flagged_at.size() <= 100)) &&
             (!('plan_tier' in data) || data.plan_tier in ['PAID', 'TRIAL', 'FREE']) &&
             (!('subscription_status' in data) || data.subscription_status in ['ACTIVE', 'PAST_DUE', 'CANCELLED']) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidBusinessSettings(data) {
      return data.keys().hasAll([
               'id', 'business_id', 'store_id', 'ownerUid', 'storeName', 'currency',
               'taxRate', 'loyaltyRatio', 'receiptHeader', 'receiptFooter', 'paperWidth',
               'logoUrl', 'tpin', 'billingAddress', 'billingCity', 'billingCountry',
               'billingPhone', 'billingEmail', 'termsAndConditions', 'printerName',
               'printerInterface', 'printerStatus', 'customPaymentMethods', 'zraConfig',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'business_id', 'store_id', 'ownerUid', 'storeName', 'currency',
               'taxRate', 'loyaltyRatio', 'receiptHeader', 'receiptFooter', 'paperWidth',
               'logoUrl', 'tpin', 'billingAddress', 'billingCity', 'billingCountry',
               'billingPhone', 'billingEmail', 'termsAndConditions', 'printerName',
               'printerInterface', 'printerStatus', 'customPaymentMethods', 'zraConfig',
               'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.storeName is string && data.storeName.size() <= 200 &&
             data.currency is string && data.currency.size() <= 20 &&
             data.taxRate is number && data.taxRate >= 0.0 &&
             data.loyaltyRatio is number && data.loyaltyRatio >= 0.0 &&
             data.receiptHeader is string && data.receiptHeader.size() <= 1000 &&
             data.receiptFooter is string && data.receiptFooter.size() <= 1000 &&
             data.paperWidth is string && data.paperWidth.size() <= 20 &&
             data.logoUrl is string && data.logoUrl.size() <= 300000 &&
             data.tpin is string && data.tpin.size() <= 100 &&
             data.billingAddress is string && data.billingAddress.size() <= 500 &&
             data.billingCity is string && data.billingCity.size() <= 200 &&
             data.billingCountry is string && data.billingCountry.size() <= 200 &&
             data.billingPhone is string && data.billingPhone.size() <= 100 &&
             data.billingEmail is string && data.billingEmail.size() <= 200 &&
             data.termsAndConditions is string && data.termsAndConditions.size() <= 4000 &&
             data.printerName is string && data.printerName.size() <= 200 &&
             data.printerInterface is string && data.printerInterface.size() <= 100 &&
             data.printerStatus is string && data.printerStatus.size() <= 100 &&
             data.customPaymentMethods is list && data.customPaymentMethods.size() <= 50 &&
             (data.customPaymentMethods.size() == 0 || data.customPaymentMethods[0] is map) &&
             data.zraConfig is map &&
             data.updatedAt is timestamp;
    }

    function isValidBusinessMembership(data) {
      return data.keys().hasAll([
               'id', 'business_id', 'store_id', 'user_id', 'memberUid', 'ownerUid',
               'cred_id', 'email', 'full_name', 'role', 'accessible_branches',
               'permissions_json', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'business_id', 'store_id', 'user_id', 'memberUid', 'ownerUid',
               'cred_id', 'email', 'full_name', 'role', 'accessible_branches',
               'permissions_json', 'status', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             data.store_id is string && data.store_id.size() <= 128 &&
             data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
             data.memberUid is string && data.memberUid.size() <= 128 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidId(data.cred_id) &&
             data.email is string && data.email.size() >= 1 && data.email.size() <= 200 &&
             data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 200 &&
             data.role in ['owner', 'manager', 'sales'] &&
             data.accessible_branches is list && data.accessible_branches.size() <= 50 &&
             (data.accessible_branches.size() == 0 || data.accessible_branches[0] is string) &&
             data.permissions_json is string && data.permissions_json.size() <= 8000 &&
             data.status in ['ACTIVE', 'SUSPENDED'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidCredentialInvite(data) {
      return data.keys().hasAll([
               'id', 'cred_id', 'auth_email', 'business_id', 'business_name', 'membership_id',
               'user_id', 'ownerUid', 'memberUid', 'email', 'full_name', 'role',
               'store_id', 'accessible_branches', 'permissions_json', 'status', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'cred_id', 'auth_email', 'business_id', 'business_name', 'membership_id',
               'user_id', 'ownerUid', 'memberUid', 'email', 'full_name', 'role',
               'store_id', 'accessible_branches', 'permissions_json', 'status', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.cred_id) &&
             data.cred_id == data.id &&
             data.auth_email is string && data.auth_email.size() >= 10 && data.auth_email.size() <= 150 &&
             isValidId(data.business_id) &&
             data.business_name is string && data.business_name.size() >= 1 && data.business_name.size() <= 200 &&
             isValidId(data.membership_id) &&
             data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUid is string && data.memberUid.size() <= 128 &&
             data.email is string && data.email.size() >= 1 && data.email.size() <= 200 &&
             data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 200 &&
             data.role in ['owner', 'manager', 'sales'] &&
             data.store_id is string && data.store_id.size() <= 128 &&
             data.accessible_branches is list && data.accessible_branches.size() <= 50 &&
             (data.accessible_branches.size() == 0 || data.accessible_branches[0] is string) &&
             data.permissions_json is string && data.permissions_json.size() <= 8000 &&
             data.status in ['ACTIVE', 'SUSPENDED'] &&
             data.updatedAt is timestamp;
    }

    function isValidStore(data) {
      return data.keys().hasAll(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'location', 'phone', 'email', 'allow_discounts', 'allow_refunds', 'allow_laybys', 'require_manager_discount']) &&
             data.keys().hasOnly(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'location', 'phone', 'email', 'allow_discounts', 'allow_refunds', 'allow_laybys', 'require_manager_discount']) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.store_id == data.id &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.location is string && data.location.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.allow_discounts is int &&
             data.allow_refunds is int &&
             data.allow_laybys is int &&
             data.require_manager_discount is int;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'sku', 'category', 'price', 'cost', 'stock', 'imageUrl']) &&
             data.keys().hasOnly(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'description', 'sku', 'category', 'price', 'cost', 'stock', 'imageUrl', 'is_service', 'batch_number', 'expiry_date', 'item_cls_cd', 'tax_ty_cd']) &&
             data.id is int &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 250 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             data.sku is string && data.sku.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.price is number && data.price >= 0.0 &&
             data.cost is number && data.cost >= 0.0 &&
             data.stock is int &&
             data.imageUrl is string && data.imageUrl.size() <= 300000 &&
             (!('is_service' in data) || data.is_service is int) &&
             (!('batch_number' in data) || (data.batch_number is string && data.batch_number.size() <= 100)) &&
             (!('expiry_date' in data) || (data.expiry_date is string && data.expiry_date.size() <= 100)) &&
             (!('item_cls_cd' in data) || (data.item_cls_cd is string && data.item_cls_cd.size() <= 100)) &&
             (!('tax_ty_cd' in data) || (data.tax_ty_cd is string && data.tax_ty_cd.size() <= 50));
    }

    function isValidStoreProduct(data) {
      return data.keys().hasAll(['id', 'product_id', 'business_id', 'store_id', 'ownerUid', 'stock', 'price', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'product_id', 'business_id', 'store_id', 'ownerUid', 'stock', 'price', 'updatedAt']) &&
             isValidId(data.id) &&
             data.product_id is int &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.stock is int &&
             data.price is number && data.price >= 0.0 &&
             data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'phone', 'email', 'loyalPoints', 'tpin', 'zra_connected', 'tax_band']) &&
             data.keys().hasOnly(['id', 'business_id', 'store_id', 'ownerUid', 'name', 'phone', 'email', 'loyalPoints', 'tpin', 'zra_connected', 'tax_band']) &&
             data.id is int &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.email is string && data.email.size() <= 200 &&
             data.loyalPoints is int && data.loyalPoints >= 0 &&
             data.tpin is string && data.tpin.size() <= 100 &&
             data.zra_connected is int &&
             data.tax_band is string && data.tax_band.size() <= 100;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'business_id', 'ownerUid', 'customerId', 'orderDate', 'subtotal', 'tax', 'discount', 'total', 'paymentMethod', 'status', 'store_id', 'performed_by']) &&
             data.keys().hasOnly(['id', 'business_id', 'ownerUid', 'customerId', 'orderDate', 'subtotal', 'tax', 'discount', 'total', 'paymentMethod', 'status', 'store_id', 'performed_by']) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             (data.customerId is int || data.customerId == null) &&
             data.orderDate is string && data.orderDate.size() >= 1 && data.orderDate.size() <= 100 &&
             data.subtotal is number && data.subtotal >= 0.0 &&
             data.tax is number && data.tax >= 0.0 &&
             data.discount is number && data.discount >= 0.0 &&
             data.total is number && data.total >= 0.0 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 50 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 50 &&
             isValidId(data.store_id) &&
             data.performed_by is string && data.performed_by.size() >= 1 && data.performed_by.size() <= 100;
    }

    function isValidOrderItem(data) {
      return data.keys().hasAll(['id', 'business_id', 'store_id', 'ownerUid', 'orderId', 'productId', 'quantity', 'unitPrice']) &&
             data.keys().hasOnly(['id', 'business_id', 'store_id', 'ownerUid', 'orderId', 'productId', 'quantity', 'unitPrice']) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
             data.productId is int &&
             data.quantity is int && data.quantity >= 1 &&
             data.unitPrice is number && data.unitPrice >= 0.0;
    }

    function isValidLedgerBackup(data) {
      return data.keys().hasAll(['id', 'business_id', 'store_id', 'ownerUid', 'ledger_type', 'record_count', 'records', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'business_id', 'store_id', 'ownerUid', 'ledger_type', 'record_count', 'records', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.business_id) &&
             isValidId(data.store_id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ledger_type is string && data.ledger_type.size() >= 1 && data.ledger_type.size() <= 100 &&
             data.record_count is int && data.record_count >= 0 &&
             data.records is list && data.records.size() <= 500 &&
             (data.records.size() == 0 || data.records[0] is map) &&
             data.updatedAt is timestamp;
    }

    function isValidSuperAdmin(data) {
      return data.keys().hasAll(['id', 'uid', 'cred_id', 'email', 'full_name', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'uid', 'cred_id', 'email', 'full_name', 'role', 'status', 'createdAt', 'updatedAt']) &&
             isValidId(data.id) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             isValidId(data.cred_id) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 200 &&
             data.role == 'SUPER_ADMIN' &&
             data.status in ['ACTIVE', 'SUSPENDED'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidPlatformAuditLog(data) {
      return data.keys().hasAll([
               'id', 'action', 'target_business_id', 'target_business_name', 'reason',
               'performed_by_uid', 'performed_by_email', 'metadata_json', 'timestamp', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'action', 'target_business_id', 'target_business_name', 'reason',
               'performed_by_uid', 'performed_by_email', 'metadata_json', 'timestamp', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             data.action in ['SUSPEND_BUSINESS', 'RESTORE_BUSINESS', 'FLAG_FRAUD', 'CLEAR_FRAUD', 'UPDATE_PLAN', 'HARD_DELETE_BUSINESS'] &&
             isValidId(data.target_business_id) &&
             data.target_business_name is string && data.target_business_name.size() >= 1 && data.target_business_name.size() <= 200 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 1000 &&
             data.performed_by_uid is string && data.performed_by_uid.size() >= 1 && data.performed_by_uid.size() <= 128 &&
             data.performed_by_email is string && data.performed_by_email.size() >= 3 && data.performed_by_email.size() <= 200 &&
             data.metadata_json is string && data.metadata_json.size() <= 4000 &&
             data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 100 &&
             data.createdAt is timestamp;
    }

    // 4. Collection & Relational Subcollection Match Rules

    // Credential Directory: Zero-plaintext (email + password) SHA-256 prefix index
    match /credential_directory/{credId} {
      allow get: if isSignedIn() && isValidId(credId) && (
        request.auth.token.email == 'cred_' + credId + '@mt-pos.auth' ||
        (resource != null && existing().ownerUid == request.auth.uid) ||
        (resource != null && isBusinessOwner(existing().business_id)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        existing().memberUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
                       isValidId(credId) &&
                       isValidCredentialInvite(incoming()) &&
                       incoming().id == credId &&
                       incoming().cred_id == credId &&
                       incoming().auth_email == 'cred_' + credId + '@mt-pos.auth' &&
                       incoming().updatedAt == request.time &&
                       isBusinessOwner(incoming().business_id) &&
                       (
                         incoming().ownerUid == request.auth.uid ||
                         incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(incoming().business_id)).data.ownerUid
                       );
      allow update: if isSignedIn() &&
                       isValidId(credId) &&
                       isValidCredentialInvite(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().cred_id == existing().cred_id &&
                       incoming().auth_email == existing().auth_email &&
                       incoming().business_id == existing().business_id &&
                       incoming().user_id == existing().user_id &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().updatedAt == request.time && (
                         (isBusinessOwner(existing().business_id) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'business_name', 'membership_id', 'memberUid', 'email',
                            'full_name', 'role', 'store_id', 'accessible_branches',
                            'permissions_json', 'status', 'updatedAt'
                          ])) ||
                         (request.auth.token.email == 'cred_' + credId + '@mt-pos.auth' &&
                          incoming().memberUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUid', 'updatedAt'])) ||
                         isAdmin()
                       );
      allow delete: if isSignedIn() && isValidId(credId) && resource != null && (
        isAdmin() ||
        existing().ownerUid == request.auth.uid ||
        isBusinessOwner(existing().business_id)
      );
    }

    // Platform-Level Super Admins (Strictly separated from regular BusinessMembership)
    match /super_admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(adminUid) &&
                       isValidSuperAdmin(incoming()) &&
                       incoming().id == adminUid &&
                       incoming().uid == adminUid &&
                       incoming().status == 'ACTIVE' &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time && (
                         isAdmin() ||
                         (
                           request.auth.uid == adminUid &&
                           request.auth.token.firebase.sign_in_provider == 'password' &&
                           incoming().email == 'cornbtechnologies@gmail.com' &&
                           incoming().cred_id == '14502f2917bd7baffecafd15a60218ad4c6a666a73d3c9c89f5ed487' &&
                           request.auth.token.email == 'cred_14502f2917bd7baffecafd15a60218ad4c6a666a73d3c9c89f5ed487@mt-pos.auth'
                         )
                       );
      allow update: if isAdmin() &&
                       isValidId(adminUid) &&
                       isValidSuperAdmin(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Immutable Chronological Super Admin Moderation Audit Logs
    match /platform_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       isValidPlatformAuditLog(incoming()) &&
                       incoming().id == logId &&
                       incoming().performed_by_uid == request.auth.uid &&
                       incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if isSignedIn() && isValidId(businessId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        isBusinessMember(businessId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(businessId) &&
                       isValidBusiness(incoming()) &&
                       incoming().id == businessId &&
                       incoming().business_id == businessId &&
                       incoming().ownerUid == request.auth.uid &&
                       (!('status' in incoming()) || incoming().status == 'ACTIVE') &&
                       (!('flagged_for_fraud' in incoming()) || incoming().flagged_for_fraud == false) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
                       isValidId(businessId) &&
                       isValidBusiness(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().business_id == businessId &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time && (
                         (
                           (existing().ownerUid == request.auth.uid || isActiveOwnerMember(businessId)) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'business_id', 'store_id', 'name', 'owner', 'email',
                             'currency', 'tax_rate', 'tpin', 'billing_address', 'billing_city',
                             'billing_country', 'billing_phone', 'billing_email', 'admin_role', 'updatedAt'
                           ])
                         ) ||
                         (
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'business_id', 'store_id', 'name', 'owner', 'email',
                             'currency', 'tax_rate', 'tpin', 'billing_address', 'billing_city',
                             'billing_country', 'billing_phone', 'billing_email', 'admin_role',
                             'status', 'suspended_reason', 'suspended_at', 'suspended_by',
                             'flagged_for_fraud', 'fraud_flag_reason', 'flagged_at',
                             'plan_tier', 'subscription_status', 'updatedAt'
                           ])
                         )
                       );
      allow delete: if isSignedIn() &&
                       isValidId(businessId) &&
                       resource != null &&
                       (isAdmin() || existing().ownerUid == request.auth.uid);

      // Subcollection: Decoupled Many-to-Many Business Memberships
      match /memberships/{membershipId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(membershipId) && (
          membershipId == request.auth.uid ||
          (resource != null && existing().memberUid == request.auth.uid) ||
          isBusinessOwner(businessId)
        );
        allow list: if isSignedIn() && (
          isAdmin() || (
            existing().business_id == businessId && (
              existing().ownerUid == request.auth.uid ||
              existing().memberUid == request.auth.uid
            )
          )
        );
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(membershipId) &&
                         isValidBusinessMembership(incoming()) &&
                         incoming().id == membershipId &&
                         incoming().business_id == businessId &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time && (
                           (isBusinessOwner(businessId) && (
                             incoming().ownerUid == request.auth.uid ||
                             incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                           )) ||
                           (
                             membershipId == request.auth.uid &&
                             incoming().memberUid == request.auth.uid &&
                             incoming().status == 'ACTIVE' &&
                             request.auth.token.email == 'cred_' + incoming().cred_id + '@mt-pos.auth' &&
                             exists(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)) &&
                             get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.business_id == businessId &&
                             get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.status == 'ACTIVE' &&
                             get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.role == incoming().role &&
                             get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.user_id == incoming().user_id &&
                             incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                           )
                         );
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(membershipId) &&
                         isValidBusinessMembership(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().user_id == existing().user_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time && (
                           (isBusinessOwner(businessId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'store_id', 'cred_id', 'email', 'full_name', 'role',
                              'accessible_branches', 'permissions_json', 'status', 'memberUid', 'updatedAt'
                            ])) ||
                           (membershipId == request.auth.uid &&
                            incoming().memberUid == request.auth.uid &&
                            incoming().cred_id == existing().cred_id &&
                            request.auth.token.email == 'cred_' + incoming().cred_id + '@mt-pos.auth' &&
                            exists(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)) &&
                            get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.business_id == businessId &&
                            get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.role == incoming().role &&
                            get(/databases/$(database)/documents/credential_directory/$(incoming().cred_id)).data.status == incoming().status &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'store_id', 'email', 'full_name', 'role', 'accessible_branches', 'permissions_json', 'status', 'updatedAt'
                            ]))
                         );
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(membershipId) && isBusinessOwner(businessId);
      }

      // Subcollection: Business Settings & Configuration
      match /settings/{settingId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(settingId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(settingId) &&
                         isValidBusinessSettings(incoming()) &&
                         incoming().id == settingId &&
                         incoming().business_id == businessId &&
                         incoming().updatedAt == request.time &&
                         isBusinessOwner(businessId) &&
                         (
                           incoming().ownerUid == request.auth.uid ||
                           incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                         );
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(settingId) &&
                         isValidBusinessSettings(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'store_id', 'storeName', 'currency', 'taxRate', 'loyaltyRatio',
                           'receiptHeader', 'receiptFooter', 'paperWidth', 'logoUrl', 'tpin',
                           'billingAddress', 'billingCity', 'billingCountry', 'billingPhone',
                           'billingEmail', 'termsAndConditions', 'printerName', 'printerInterface',
                           'printerStatus', 'customPaymentMethods', 'zraConfig', 'updatedAt'
                         ]) &&
                         isBusinessOwner(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(settingId) && isBusinessOwner(businessId);
      }

      // Subcollection: Store Branches
      match /stores/{storeId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(storeId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(storeId) &&
                         isValidStore(incoming()) &&
                         incoming().id == storeId &&
                         incoming().store_id == storeId &&
                         incoming().business_id == businessId &&
                         isBusinessOwner(businessId) &&
                         (
                           incoming().ownerUid == request.auth.uid ||
                           incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                         );
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(storeId) &&
                         isValidStore(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().store_id == storeId &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'name', 'location', 'phone', 'email', 'allow_discounts', 'allow_refunds', 'allow_laybys', 'require_manager_discount']) &&
                         isBusinessOwner(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(storeId) && isBusinessOwner(businessId);
      }

      // Subcollection: Product Catalog & Batches
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(productId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().business_id == businessId &&
                         isBusinessOwner(businessId) &&
                         (
                           incoming().ownerUid == request.auth.uid ||
                           incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                         );
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid && (
                           (isBusinessOwner(businessId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'name', 'description', 'sku', 'category', 'price', 'cost', 'stock', 'imageUrl', 'is_service', 'batch_number', 'expiry_date', 'item_cls_cd', 'tax_ty_cd'])) ||
                           (isBusinessMember(businessId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['stock']))
                         );
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(productId) && isBusinessOwner(businessId);
      }

      // Subcollection: Per-Branch Store Stock Levels
      match /store_products/{storeProductId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(storeProductId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(storeProductId) &&
                         isValidStoreProduct(incoming()) &&
                         incoming().id == storeProductId &&
                         incoming().business_id == businessId &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().updatedAt == request.time &&
                         isBusinessMember(businessId);
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(storeProductId) &&
                         isValidStoreProduct(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().product_id == existing().product_id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().updatedAt == request.time && (
                           (isBusinessOwner(businessId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'stock', 'price', 'updatedAt'])) ||
                           (isBusinessMember(businessId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(storeProductId) && isBusinessOwner(businessId);
      }

      // Subcollection: Client CRM Data
      match /customers/{customerId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(customerId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().business_id == businessId &&
                         isBusinessMember(businessId);
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'name', 'phone', 'email', 'loyalPoints', 'tpin', 'zra_connected', 'tax_band']) &&
                         isBusinessMember(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(customerId) && isBusinessOwner(businessId);
      }

      // Subcollection: POS Sales & Refund Orders (Transactions)
      match /orders/{orderId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(orderId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(orderId) &&
                         isValidOrder(incoming()) &&
                         incoming().id == orderId &&
                         incoming().business_id == businessId &&
                         incoming().ownerUid == request.auth.uid &&
                         isBusinessMember(businessId);
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(orderId) &&
                         isValidOrder(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().orderDate == existing().orderDate &&
                         incoming().store_id == existing().store_id &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentMethod', 'total', 'subtotal', 'tax', 'discount', 'customerId', 'performed_by']) &&
                         isBusinessMember(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(orderId) && isBusinessOwner(businessId);
      }

      // Subcollection: Order Line Items (Relational link between Orders and Products)
      match /order_items/{itemId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(itemId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(itemId) &&
                         isValidOrderItem(incoming()) &&
                         incoming().id == itemId &&
                         incoming().business_id == businessId &&
                         incoming().ownerUid == request.auth.uid &&
                         isBusinessMember(businessId);
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(itemId) &&
                         isValidOrderItem(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().orderId == existing().orderId &&
                         incoming().productId == existing().productId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'quantity', 'unitPrice']) &&
                         isBusinessMember(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(itemId) && isBusinessOwner(businessId);
      }

      // Subcollection: Double-Entry Accounting & Client Relational Ledger Backups
      match /ledgers/{ledgerId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(ledgerId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (isAdmin() || (existing().business_id == businessId && isBusinessMember(businessId)));
        allow create: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(ledgerId) &&
                         isValidLedgerBackup(incoming()) &&
                         incoming().id == ledgerId &&
                         incoming().business_id == businessId &&
                         incoming().updatedAt == request.time &&
                         isBusinessOwner(businessId) &&
                         (
                           incoming().ownerUid == request.auth.uid ||
                           incoming().ownerUid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
                         );
        allow update: if isSignedIn() &&
                         isValidId(businessId) &&
                         isValidId(ledgerId) &&
                         isValidLedgerBackup(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().business_id == existing().business_id &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().ledger_type == existing().ledger_type &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['store_id', 'record_count', 'records', 'updatedAt']) &&
                         isBusinessOwner(businessId);
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(ledgerId) && isBusinessOwner(businessId);
      }
    }
  }
}
