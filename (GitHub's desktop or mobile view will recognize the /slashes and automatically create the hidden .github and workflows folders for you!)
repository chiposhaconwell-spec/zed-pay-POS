name: Build Android APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-android:
    runs-on: ubuntu-latest

    steps:
      - name: 1. Checkout Repository Code
        uses: actions/checkout@v4

      - name: 2. Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: 3. Setup Java JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: 4. Install Dependencies & Build Web App
        run: |
          npm install
          npm run build

      - name: 5. Wrap in Capacitor & Configure Android
        run: |
          npm install @capacitor/core@latest @capacitor/cli@latest @capacitor/android@latest
          if [ ! -f "capacitor.config.json" ] && [ ! -f "capacitor.config.ts" ]; then
            npx cap init "ZedPay POS" "com.zedpay.pos" --web-dir dist
          fi
          if [ ! -d "android" ]; then
            npx cap add android
          fi
          sed -i 's/<application/<application android:usesCleartextTraffic="true"/g' android/app/src/main/AndroidManifest.xml
          npx cap sync android

      - name: 6. Compile APK with Gradle
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: 7. Upload Downloadable APK
        uses: actions/upload-artifact@v4
        with:
          name: ZedPay-POS-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
